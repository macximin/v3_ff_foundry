{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "firefly_screenwork_status_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_schema",
    "template_origin_version",
    "family_id",
    "screenwork_id",
    "variant_id",
    "owner_id",
    "source_kind",
    "format_profile",
    "screen_stage",
    "current_episode",
    "approved_through",
    "planning_state_through",
    "target_runtime_seconds",
    "approval_authority",
    "storage_backend",
    "blockers"
  ],
  "properties": {
    "schema_version": {"const": "firefly_screenwork_status_v1"},
    "workflow_schema": {"const": "firefly_screenplay_loop_v1"},
    "template_origin_version": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "screenwork_id": {"type": "string", "minLength": 1},
    "variant_id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "owner_id": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["novel_adaptation", "screen_original"]},
    "format_profile": {"type": "string", "minLength": 1},
    "screen_stage": {
      "enum": [
        "none",
        "source_binding",
        "screen_brief",
        "format_bible",
        "season_design",
        "episode_promise",
        "scene_cards",
        "timed_script",
        "review",
        "approved_script"
      ]
    },
    "current_episode": {"type": "string", "pattern": "^ep[0-9]+$"},
    "approved_through": {"type": "string", "pattern": "^ep[0-9]+$"},
    "planning_state_through": {"type": "string", "pattern": "^ep[0-9]+$"},
    "source_binding_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "target_runtime_seconds": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "number", "minimum": 1},
        "max": {"type": "number", "minimum": 1}
      },
      "additionalProperties": false
    },
    "approval_authority": {"const": "owner"},
    "storage_backend": {"const": "gdrive_personal_v0"},
    "next_action": {"type": ["string", "null"]},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "updated_at": {"type": ["string", "null"]}
  }
}
